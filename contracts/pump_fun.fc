#include "imports/stdlib.fc";
#include "imports/params.fc";
#include "imports/jetton-utils.fc";

const op::create_token = "op::create_token"c;

(cell, cell) load_data() inline {
  slice ds = get_data().begin_parse();
  return (
    ds~load_ref(),
    ds~load_ref()
  );
}

() save_data(cell content, cell jetton_minter_code) impure inline {
  set_data(begin_cell()
            .store_ref(content)
            .store_ref(jetton_minter_code)
            .end_cell()
  );
}

() create_token(slice owner_address, slice name, slice symbol, int reserve_ratio, cell jetton_minter_code, int amount) impure {
  cell state_init = calculate_jetton_minter_state_init(owner_address, name, symbol, reserve_ratio, my_address(), jetton_minter_code);
  slice to_minter_address = calculate_jetton_minter_address(state_init);

  var msg = begin_cell()
    .store_uint(0x18, 6)
    .store_slice(to_minter_address)
    .store_coins(amount)
    .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
    .store_ref(state_init);
  send_raw_message(msg.end_cell(), 1);
}

() recv_internal(cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) {
    return ();
  }

  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) { ;; ignore all bounced messages
    return ();
  }

  slice sender_address = cs~load_msg_addr();
  cs~load_msg_addr(); ;; skip dst
  cs~load_coins(); ;; skip value
  cs~skip_bits(1); ;; skip extracurrency collection
  cs~load_coins(); ;; skip ihr_fee
  int fwd_fee = cs~load_coins(); ;; we use message fwd_fee for estimation of provide_wallet_address cost

  int op = in_msg_body~load_uint(32);
  int query_id = in_msg_body~load_uint(64);
  
  (cell content, cell jetton_minter_code) = load_data();
  if (op == op::create_token) {
    slice to_address = in_msg_body~load_msg_addr();
    int amount = in_msg_body~load_coins();
    int reserve_ratio = in_msg_body~load_uint(32);
    slice name = in_msg_body~load_bits(128);
    slice symbol = in_msg_body~load_bits(64);
    create_token(sender_address, name, symbol, reserve_ratio, jetton_minter_code, amount);

    return ();
  }

  throw(0xffff);
}